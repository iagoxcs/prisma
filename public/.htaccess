# KingHost (Apache) — copiado para a raiz do site no build estático.
# O site não tem backend próprio: dados, login, arquivos e regras ficam no Supabase.
# Este arquivo só cuida de HTTPS, rotas, cache e cabeçalhos de segurança.
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Força HTTPS (o SSL do subdomínio é emitido no painel da KingHost).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Rotas sem barra final (/projetos → /projetos/), igual ao trailingSlash do next.config.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

ErrorDocument 404 /404.html

# Arquivos de controle do deploy por FTP não podem ser baixados.
<FilesMatch "^(\.ftp-deploy-sync-state\.json|\.htaccess|\.env.*)$">
  Require all denied
</FilesMatch>

# Assets com hash do Next podem ser cacheados "para sempre"; HTML e version.txt nunca.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compressão de texto (HTML, JS, CSS, JSON, SVG).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
